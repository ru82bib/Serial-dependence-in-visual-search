      <CodeComponent name="code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# All RTs from correct trials&amp;#10;rt_list = []&amp;#10;correct_responses = []&amp;#10;&amp;#10;# Counters for each probe type&amp;#10;probe_counts = {'fast': 0, 'avg': 0, 'slow': 0, 'ran': 0}&amp;#10;max_probes = 14&amp;#10;total_probe_limit = 42&amp;#10;&amp;#10;# Control when a probe was last shown&amp;#10;trials_since_last_probe = 99  # just large to begin&amp;#10;&amp;#10;# For identifying if current trial is a probe&amp;#10;next_is_probe = False&amp;#10;next_probe_type = None&amp;#10;previous_was_probe = False" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="rt_list = [];&amp;#10;correct_responses = [];&amp;#10;probe_counts = {&quot;fast&quot;: 0, &quot;avg&quot;: 0, &quot;slow&quot;: 0, &quot;ran&quot;: 0};&amp;#10;max_probes = 14;&amp;#10;total_probe_limit = 42;&amp;#10;trials_since_last_probe = 99;&amp;#10;next_is_probe = false;&amp;#10;next_probe_type = null;&amp;#10;previous_was_probe = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="show_instructions = next_is_probe;&amp;#10;instruction_timer = new util.Clock();&amp;#10;if (show_instructions) {&amp;#10;    carry_shape = Shape;&amp;#10;}&amp;#10;ShapeForStim = (previous_was_probe ? carry_shape : Shape);&amp;#10;is_probe = next_is_probe;&amp;#10;probe_type = next_probe_type;&amp;#10;is_instruction_trial = next_is_probe;&amp;#10;is_stimulus_trial = previous_was_probe;&amp;#10;show_instruction = false;&amp;#10;if (show_instructions) {&amp;#10;    instruction_text.text = (&quot;Search for &quot; + Shape);&amp;#10;    instruction_timer.reset();&amp;#10;    instruction_text.setAutoDraw(true);&amp;#10;    fix_cross.setAutoDraw(false);&amp;#10;} else {&amp;#10;    instruction_text.setAutoDraw(false);&amp;#10;    fix_cross.setAutoDraw(true);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="show_instructions = next_is_probe&amp;#10;instruction_timer = core.Clock()&amp;#10;&amp;#10;if show_instructions:&amp;#10;    carry_shape = Shape  # remember what we just instructed&amp;#10;&amp;#10;ShapeForStim = carry_shape if previous_was_probe else Shape&amp;#10;&amp;#10;is_probe = next_is_probe&amp;#10;probe_type = next_probe_type&amp;#10;is_instruction_trial = next_is_probe  # trial n&amp;#10;is_stimulus_trial = previous_was_probe  # trial n+1&amp;#10;#show_stimuli = True&amp;#10;show_instruction = False&amp;#10;&amp;#10;&amp;#10;if show_instructions:&amp;#10;    instruction_text.text = &quot;Search for &quot; + Shape&amp;#10;    instruction_timer.reset()&amp;#10;    instruction_text.setAutoDraw(True)&amp;#10;    fix_cross.setAutoDraw(False)&amp;#10;else:&amp;#10;    instruction_text.setAutoDraw(False)&amp;#10;    fix_cross.setAutoDraw(True)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
