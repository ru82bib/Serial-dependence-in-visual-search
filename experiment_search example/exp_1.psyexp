      </RoutineSettingsComponent>
      <CodeComponent name="trial_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# All RTs from correct trials&amp;#10;rt_list = []&amp;#10;correct_responses = []&amp;#10;&amp;#10;# Counters for each probe type&amp;#10;probe_counts = {'fast': 0, 'avg': 0, 'slow': 0, 'ran': 0}&amp;#10;max_probes = 14&amp;#10;total_probe_limit = 42&amp;#10;&amp;#10;# Control when a probe was last shown&amp;#10;trials_since_last_probe = 99  # just large to begin&amp;#10;&amp;#10;# For identifying if current trial is a probe&amp;#10;next_is_probe = False&amp;#10;next_probe_type = None&amp;#10;previous_was_probe = False&amp;#10;response_error = False&amp;#10;no_response = False&amp;#10;correct_response = None&amp;#10;feedback_reps = 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="rt_list = [];&amp;#10;correct_responses = [];&amp;#10;probe_counts = {&quot;fast&quot;: 0, &quot;avg&quot;: 0, &quot;slow&quot;: 0, &quot;ran&quot;: 0};&amp;#10;max_probes = 14;&amp;#10;total_probe_limit = 42;&amp;#10;trials_since_last_probe = 99;&amp;#10;next_is_probe = false;&amp;#10;next_probe_type = null;&amp;#10;previous_was_probe = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;import * as random from 'random';&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if ((! _pj.in_es6(&quot;carry_shape&quot;, globals()))) {&amp;#10;    carry_shape = null;&amp;#10;}&amp;#10;stim_clock = new util.Clock();&amp;#10;instruction_timer = new util.Clock();&amp;#10;show_instructions = next_is_probe;&amp;#10;show_stimuli = (! next_is_probe);&amp;#10;stim_duration = 0.8;&amp;#10;total_duration = 1.3;&amp;#10;if (show_instructions) {&amp;#10;    carry_shape = Shape;&amp;#10;}&amp;#10;ShapeForStim = (previous_was_probe ? carry_shape : Shape);&amp;#10;is_probe = next_is_probe;&amp;#10;probe_type = next_probe_type;&amp;#10;is_instruction_trial = next_is_probe;&amp;#10;is_stimulus_trial = previous_was_probe;&amp;#10;show_instruction = false;&amp;#10;correct_resp = null;&amp;#10;theta = [0, 45, 90, 135, 180, 225, 270, 315];&amp;#10;thetarad = function () {&amp;#10;    var _pj_a = [], _pj_b = theta;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var t = _pj_b[_pj_c];&amp;#10;        _pj_a.push(((t * Math.PI) / 180));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;posx = function () {&amp;#10;    var _pj_a = [], _pj_b = thetarad;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var t = _pj_b[_pj_c];&amp;#10;        _pj_a.push((4 * Math.cos(t)));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;posy = function () {&amp;#10;    var _pj_a = [], _pj_b = thetarad;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var t = _pj_b[_pj_c];&amp;#10;        _pj_a.push((4 * Math.sin(t)));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;CircleDist = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(8);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(new visual.ShapeStim({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;&quot;, &quot;size&quot;: [2, 2], &quot;vertices&quot;: &quot;circle&quot;, &quot;ori&quot;: 45.0, &quot;pos&quot;: [posx[i], posy[i]], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 8.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: null, &quot;opacity&quot;: 1.0, &quot;depth&quot;: (- 1.0), &quot;interpolate&quot;: true}));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;DiamondDist = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(8);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;&quot;, &quot;width&quot;: [2, 2][0], &quot;height&quot;: [2, 2][1], &quot;ori&quot;: 45.0, &quot;pos&quot;: [posx[i], posy[i]], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 8.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: null, &quot;opacity&quot;: 1.0, &quot;depth&quot;: (- 2.0), &quot;interpolate&quot;: true}));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;DistLines = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(8);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;TargetLine&quot;, &quot;width&quot;: [0.3, 1.5][0], &quot;height&quot;: [0.3, 1.5][1], &quot;ori&quot;: 1.0, &quot;pos&quot;: [posx[i], posy[i]], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 1.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: &quot;white&quot;, &quot;opacity&quot;: null, &quot;depth&quot;: (- 3.0), &quot;interpolate&quot;: true}));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;CircleTarget = new visual.ShapeStim({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;CircleTarget&quot;, &quot;size&quot;: [2, 2], &quot;vertices&quot;: &quot;circle&quot;, &quot;ori&quot;: 45.0, &quot;pos&quot;: [0, 0], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 1.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: null, &quot;opacity&quot;: 1.0, &quot;depth&quot;: (- 1.0), &quot;interpolate&quot;: true});&amp;#10;DiamondTarget = new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;DiamondTarget&quot;, &quot;width&quot;: [2, 2][0], &quot;height&quot;: [2, 2][1], &quot;ori&quot;: 45.0, &quot;pos&quot;: [0, 0], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 1.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: null, &quot;opacity&quot;: 1.0, &quot;depth&quot;: (- 2.0), &quot;interpolate&quot;: true});&amp;#10;TargetLine = new visual.Rect({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;TargetLine&quot;, &quot;width&quot;: [0.3, 1.5][0], &quot;height&quot;: [0.3, 1.5][1], &quot;ori&quot;: 1.0, &quot;pos&quot;: [0, 0], &quot;anchor&quot;: &quot;center&quot;, &quot;lineWidth&quot;: 1.0, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;lineColor&quot;: &quot;white&quot;, &quot;fillColor&quot;: &quot;white&quot;, &quot;opacity&quot;: null, &quot;depth&quot;: (- 3.0), &quot;interpolate&quot;: true});&amp;#10;CircleTarget.setPos([posx[TarPos], posy[TarPos]]);&amp;#10;CircleTarget.setLineColor(Color);&amp;#10;CircleTarget.setLineWidth(((ShapeForStim === &quot;Circle&quot;) ? 8 : 0));&amp;#10;DiamondTarget.setPos([posx[TarPos], posy[TarPos]]);&amp;#10;DiamondTarget.setLineColor(Color);&amp;#10;DiamondTarget.setLineWidth(((ShapeForStim === &quot;Circle&quot;) ? 0 : 8));&amp;#10;TargetLine.setPos([posx[TarPos], posy[TarPos]]);&amp;#10;TargetLine.setOri(LineOri);&amp;#10;DistOri = function () {&amp;#10;    var _pj_a = [], _pj_b = util.range(8);&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push((np.random.randint(2) * 90));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;shapes = [];&amp;#10;if ((ShapeForStim === &quot;Circle&quot;)) {&amp;#10;    for (var i, _pj_c = 0, _pj_a = util.range(8), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        i = _pj_a[_pj_c];&amp;#10;        if ((i === TarPos)) {&amp;#10;            shapes.push(CircleTarget);&amp;#10;            shapes.push(TargetLine);&amp;#10;            continue;&amp;#10;        }&amp;#10;        if ((i !== TarPos)) {&amp;#10;            DiamondDist[i].lineColor = Color;&amp;#10;            DistLines[i].ori = DistOri[i];&amp;#10;            shapes.push(DiamondDist[i]);&amp;#10;            shapes.push(DistLines[i]);&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    for (var i, _pj_c = 0, _pj_a = util.range(8), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        i = _pj_a[_pj_c];&amp;#10;        if ((i === TarPos)) {&amp;#10;            shapes.push(DiamondTarget);&amp;#10;            shapes.push(TargetLine);&amp;#10;            continue;&amp;#10;        }&amp;#10;        if ((i !== TarPos)) {&amp;#10;            CircleDist[i].lineColor = Color;&amp;#10;            DistLines[i].ori = DistOri[i];&amp;#10;            shapes.push(CircleDist[i]);&amp;#10;            shapes.push(DistLines[i]);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;/*for i in range(8):&amp;#10;if i != TarPos:&amp;#10;DistLines[i].setOri(DistOri[i])&amp;#10;DistLines[i].setAutoDraw(True)*/&amp;#10;stim_started = false;&amp;#10;/*if show_instructions:&amp;#10;instruction_text.text = &quot;Search for &quot; + Shape&amp;#10;instruction_timer.reset()&amp;#10;instruction_text.setAutoDraw(True)&amp;#10;fix_cross.setAutoDraw(False)&amp;#10;else:&amp;#10;instruction_text.setAutoDraw(False)&amp;#10;fix_cross.setAutoDraw(True)*/&amp;#10;psychoJS.experiment.addData(&quot;DistOri&quot;, DistOri);&amp;#10;psychoJS.experiment.addData(&quot;show_instruction&quot;, show_instruction);&amp;#10;psychoJS.experiment.addData(&quot;show_stimuli&quot;, show_stimuli);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import numpy as np &amp;#10;import random&amp;#10;&amp;#10;if 'carry_shape' not in globals():&amp;#10;    carry_shape = None&amp;#10;    &amp;#10;# for before trial fixation&amp;#10;pre_fix_clock = core.Clock() &amp;#10;pre_fix_phase = True &amp;#10;pre_fix_dur = 0.5&amp;#10;&amp;#10;response_error = False&amp;#10;no_response = False&amp;#10;correct_response = None&amp;#10;feedback = False&amp;#10;# Set timing&amp;#10;stim_clock = core.Clock()&amp;#10;instruction_timer = core.Clock()&amp;#10;fix_clock = core.Clock()&amp;#10;&amp;#10;show_instructions = next_is_probe&amp;#10;#show_stimuli = not next_is_probe&amp;#10;pre_fix_phase = not show_instructions&amp;#10;show_fix = not show_instructions&amp;#10;stim_duration = 0.8  # shapes shown for 800ms&amp;#10;total_duration = 1.3  # shapes + response window (800ms + 1s)&amp;#10;&amp;#10;if show_instructions:&amp;#10;    carry_shape = Shape  # remember what we just instructed&amp;#10;&amp;#10;ShapeForStim = carry_shape if previous_was_probe else Shape&amp;#10;&amp;#10;is_probe = next_is_probe&amp;#10;probe_type = next_probe_type&amp;#10;is_instruction_trial = next_is_probe  # trial n&amp;#10;is_stimulus_trial = previous_was_probe  # trial n+1&amp;#10;show_stimuli = True&amp;#10;show_instruction = False&amp;#10;#correct_resp = None&amp;#10;&amp;#10;# code from search_ex&amp;#10;theta = [0, 45, 90, 135, 180, 225, 270, 315]&amp;#10;thetarad = [t*pi/180 for t in theta]&amp;#10;posx = [4*cos(t) for t in thetarad]&amp;#10;posy = [4*sin(t) for t in thetarad]&amp;#10;&amp;#10;&amp;#10;CircleDist = [visual.ShapeStim(&amp;#10;        win=win, name='',&amp;#10;        size=(2, 2), vertices='circle',&amp;#10;        ori=45.0, pos=[posx[i],posy[i]], &amp;#10;        anchor='center',&amp;#10;        lineWidth=8.0, colorSpace='rgb',  &amp;#10;        lineColor='white', fillColor=None,&amp;#10;        opacity=1.0, depth=-1.0, interpolate=True)&amp;#10;        for i in range(8)]&amp;#10;        &amp;#10;DiamondDist = [visual.Rect(&amp;#10;    win=win, name='',&amp;#10;    width=(2, 2)[0], height=(2, 2)[1],&amp;#10;    ori=45.0, pos=[posx[i],posy[i]],&amp;#10;    anchor='center',&amp;#10;    lineWidth=8.0, colorSpace='rgb', &amp;#10;    lineColor='white', fillColor=None,&amp;#10;    opacity=1.0, depth=-2.0, interpolate=True)&amp;#10;    for i in range(8)]&amp;#10;    &amp;#10;DistLines = [visual.Rect(&amp;#10;        win=win, name='TargetLine',&amp;#10;        width=(0.3, 1.5)[0], height=(0.3, 1.5)[1],&amp;#10;        ori=1.0, pos=[posx[i],posy[i]], anchor='center',&amp;#10;        lineWidth=1.0,     colorSpace='rgb',  lineColor='white', fillColor='white',&amp;#10;        opacity=None, depth=-3.0, interpolate=True)&amp;#10;        for i in range(8)]&amp;#10;&amp;#10;# adding target stimuli&amp;#10;CircleTarget = visual.ShapeStim(&amp;#10;        win=win, name='CircleTarget',&amp;#10;        size=(2, 2), vertices='circle',&amp;#10;        ori=45.0, pos=[0,0], anchor='center',&amp;#10;        lineWidth=1.0,     colorSpace='rgb',  lineColor='white', fillColor=None,&amp;#10;        opacity=1.0, depth=-1.0, interpolate=True)&amp;#10;DiamondTarget = visual.Rect(&amp;#10;        win=win, name='DiamondTarget',&amp;#10;        width=(2, 2)[0], height=(2, 2)[1],&amp;#10;        ori=45.0, pos=[0,0], anchor='center',&amp;#10;        lineWidth=1.0,     colorSpace='rgb',  lineColor='white', fillColor=None,&amp;#10;        opacity=1.0, depth=-2.0, interpolate=True)&amp;#10;TargetLine = visual.Rect(&amp;#10;        win=win, name='TargetLine',&amp;#10;        width=(0.3, 1.5)[0], height=(0.3, 1.5)[1],&amp;#10;        ori=1.0, pos=[0,0], anchor='center',&amp;#10;        lineWidth=1.0,     colorSpace='rgb',  lineColor='white', fillColor='white',&amp;#10;        opacity=None, depth=-3.0, interpolate=True)&amp;#10;&amp;#10;CircleTarget.setPos((posx[TarPos], posy[TarPos]))&amp;#10;CircleTarget.setLineColor(Color)&amp;#10;CircleTarget.setLineWidth((8 if ShapeForStim==&quot;Circle&quot; else 0))&amp;#10;DiamondTarget.setPos((posx[TarPos], posy[TarPos]))&amp;#10;DiamondTarget.setLineColor(Color)&amp;#10;DiamondTarget.setLineWidth((0 if ShapeForStim==&quot;Circle&quot; else 8) )&amp;#10;TargetLine.setPos((posx[TarPos], posy[TarPos]))&amp;#10;TargetLine.setOri(LineOri)&amp;#10;&amp;#10;DistOri = [np.random.randint(2)*90 for i in range(8)]&amp;#10;shapes = []&amp;#10;if ShapeForStim == &quot;Circle&quot;:&amp;#10;    for i in range(8):&amp;#10;        if i == TarPos:&amp;#10;            shapes.append(CircleTarget)&amp;#10;            shapes.append(TargetLine)&amp;#10;            continue&amp;#10;        if i != TarPos:&amp;#10;            DiamondDist[i].lineColor = Color&amp;#10;            DistLines[i].ori = DistOri[i]&amp;#10;            shapes.append(DiamondDist[i])&amp;#10;            shapes.append(DistLines[i])&amp;#10;            &amp;#10;else:&amp;#10;   for i in range(8):&amp;#10;        if i == TarPos:&amp;#10;            shapes.append(DiamondTarget)&amp;#10;            shapes.append(TargetLine)&amp;#10;            continue&amp;#10;        if i != TarPos:&amp;#10;            CircleDist[i].lineColor = Color&amp;#10;            DistLines[i].ori = DistOri[i]&amp;#10;            shapes.append(CircleDist[i])&amp;#10;            shapes.append(DistLines[i])&amp;#10;&amp;#10;'''for i in range(8):&amp;#10;    if i != TarPos:&amp;#10;        DistLines[i].setOri(DistOri[i])&amp;#10;        DistLines[i].setAutoDraw(True)'''&amp;#10;&amp;#10;stim_started = False&amp;#10;&amp;#10;# instruction text toggle&amp;#10;if show_instructions:  &amp;#10;    pre_fix_phase = False&amp;#10;    instruction_timer.reset()&amp;#10;    instruction_text.text = &quot;Search for &quot; + Shape&amp;#10;    instruction_text.setAutoDraw(True)&amp;#10;    fix_cross.setAutoDraw(False)&amp;#10;    correct_response = 'up' if LineOri == 0 else 'left'&amp;#10;else:&amp;#10;    pre_fix_phase = True&amp;#10;    pre_fix_clock.reset()&amp;#10;    instruction_text.setAutoDraw(False)&amp;#10;    fix_cross.setAutoDraw(True)&amp;#10;    correct_response = 'q' if Color == 'Lawngreen' else 'w'&amp;#10;&amp;#10;thisExp.addData('DistOri', DistOri)&amp;#10;            &amp;#10;# Save data&amp;#10;thisExp.addData('show_instruction', show_instruction)&amp;#10;thisExp.addData('show_stimuli', show_stimuli)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
