        <Param val="if ((response_error &amp;&amp; is_probe)) {&amp;#10;    feedback_text.text = &quot;Error&quot;;&amp;#10;    feedback_text.setAutoDraw(true);&amp;#10;}&amp;#10;if (no_response) {&amp;#10;    feedback_text.text = &quot;Too slow&quot;;&amp;#10;    feedback_text.setAutoDraw(true);&amp;#10;}&amp;#10;console.log(feedback_text.text);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
