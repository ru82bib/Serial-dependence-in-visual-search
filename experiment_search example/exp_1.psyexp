        <Param val="# Instruction timing&amp;#10;if show_instructions:&amp;#10;    # ensure nothing else is on while instruction shows&amp;#10;    if stim_started:&amp;#10;        for s in shapes: &amp;#10;            s.setAutoDraw(False)&amp;#10;        stim_started = False&amp;#10;&amp;#10;    instruction_text.setAutoDraw(True)&amp;#10;    fix_cross.setAutoDraw(False)&amp;#10;&amp;#10;    #if instruction_timer.getTime() &gt;= 1.0:&amp;#10;    if instruction_timer.getTime() &gt;= 0.5:&amp;#10;        # transition to stimulus phase without ending the trial&amp;#10;        show_instructions = False&amp;#10;    &amp;#10;        # clean up instruction visuals&amp;#10;        instruction_text.setAutoDraw(False)&amp;#10;        #show_stimuli = True&amp;#10;        #show_fix = True&amp;#10;        #fix_clock.reset()&amp;#10;        pre_fix_phase = True&amp;#10;        pre_fix_clock.reset()&amp;#10;        fix_cross.setAutoDraw(True)&amp;#10;&amp;#10;    #    (re)start stimulus timing&amp;#10;        #stim_started = False&amp;#10;        #stim_clock.reset()&amp;#10;        #key_resp.clock.reset()&amp;#10;&amp;#10;# new fixation before trial block&amp;#10;# Pre-fixation: 500 ms of fixation-only before stimuli&amp;#10;if pre_fix_phase:&amp;#10;    fix_cross.setAutoDraw(True)&amp;#10;    # make sure stimuli are off&amp;#10;    if stim_started:&amp;#10;        for s in shapes:&amp;#10;            s.setAutoDraw(False)&amp;#10;        stim_started = False&amp;#10;&amp;#10;    if pre_fix_clock.getTime() &gt;= pre_fix_dur:&amp;#10;        pre_fix_phase = False&amp;#10;        show_stimuli = True&amp;#10;        stim_clock.reset()&amp;#10;        key_resp.clock.reset()&amp;#10;&amp;#10;&amp;#10;# Stimulus timing&amp;#10;if show_stimuli and not show_instructions and not pre_fix_phase:&amp;#10;    if not stim_started:&amp;#10;        stim_clock.reset()&amp;#10;        key_resp.clock.reset()&amp;#10;        for s in shapes: &amp;#10;            s.setAutoDraw(True)&amp;#10;        stim_started = True&amp;#10;&amp;#10;    if stim_clock.getTime() &gt;= stim_duration or key_resp.keys:&amp;#10;        for s in shapes: &amp;#10;            s.setAutoDraw(False)&amp;#10;        continueRoutine = False  # or leave True if you want a post-stim window&amp;#10;&amp;#10;# Safety: if we’re about to leave, make sure nothing remains&amp;#10;if not continueRoutine:&amp;#10;    for s in shapes: s.setAutoDraw(False)&amp;#10;    instruction_text.setAutoDraw(False)&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (show_instructions) {&amp;#10;    if (stim_started) {&amp;#10;        for (var s, _pj_c = 0, _pj_a = shapes, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;            s = _pj_a[_pj_c];&amp;#10;            s.setAutoDraw(false);&amp;#10;        }&amp;#10;        stim_started = false;&amp;#10;    }&amp;#10;    instruction_text.setAutoDraw(true);&amp;#10;    fix_cross.setAutoDraw(false);&amp;#10;    if ((instruction_timer.getTime() &gt;= 1.0)) {&amp;#10;        show_instructions = false;&amp;#10;        show_stimuli = true;&amp;#10;        instruction_text.setAutoDraw(false);&amp;#10;        fix_cross.setAutoDraw(true);&amp;#10;        stim_started = false;&amp;#10;        stim_clock.reset();&amp;#10;        key_resp.clock.reset();&amp;#10;    }&amp;#10;}&amp;#10;if ((show_stimuli &amp;&amp; (! show_instructions))) {&amp;#10;    if ((! stim_started)) {&amp;#10;        stim_clock.reset();&amp;#10;        key_resp.clock.reset();&amp;#10;        for (var s, _pj_c = 0, _pj_a = shapes, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;            s = _pj_a[_pj_c];&amp;#10;            s.setAutoDraw(true);&amp;#10;        }&amp;#10;        stim_started = true;&amp;#10;    }&amp;#10;    if (((stim_clock.getTime() &gt;= stim_duration) || key_resp.keys)) {&amp;#10;        for (var s, _pj_c = 0, _pj_a = shapes, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;            s = _pj_a[_pj_c];&amp;#10;            s.setAutoDraw(false);&amp;#10;        }&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;if ((! continueRoutine)) {&amp;#10;    for (var s, _pj_c = 0, _pj_a = shapes, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        s = _pj_a[_pj_c];&amp;#10;        s.setAutoDraw(false);&amp;#10;    }&amp;#10;    instruction_text.setAutoDraw(false);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;response = (key_resp.keys ? key_resp.keys : null);&amp;#10;rt = (key_resp.keys ? key_resp.rt : null);&amp;#10;if ((response === correct_resp)) {&amp;#10;    correct = 1;&amp;#10;} else {&amp;#10;    correct = 0;&amp;#10;}&amp;#10;correct_responses.push(correct);&amp;#10;for (var d, _pj_c = 0, _pj_a = DiamondDist, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    d = _pj_a[_pj_c];&amp;#10;    d.setAutoDraw(false);&amp;#10;}&amp;#10;for (var d, _pj_c = 0, _pj_a = CircleDist, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    d = _pj_a[_pj_c];&amp;#10;    d.setAutoDraw(false);&amp;#10;}&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(8), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    DistLines[i].setAutoDraw(false);&amp;#10;}&amp;#10;total_trials = correct_responses.length;&amp;#10;total_correct = util.sum(correct_responses);&amp;#10;accuracy = ((total_trials &gt; 0) ? (total_correct / total_trials) : 0);&amp;#10;accuracy_percent = util.round((accuracy * 100), 2);&amp;#10;psychoJS.experiment.addData(&quot;response&quot;, response);&amp;#10;psychoJS.experiment.addData(&quot;rt&quot;, rt);&amp;#10;psychoJS.experiment.addData(&quot;correct_resp&quot;, correct_resp);&amp;#10;psychoJS.experiment.addData(&quot;correct&quot;, correct);&amp;#10;psychoJS.experiment.addData(&quot;correct_sum&quot;, accuracy_percent);&amp;#10;psychoJS.experiment.addData(&quot;is_probe&quot;, is_probe);&amp;#10;psychoJS.experiment.addData(&quot;probe_type&quot;, probe_type);&amp;#10;psychoJS.experiment.addData(&quot;rt_mu&quot;, (_pj.in_es6(&quot;mu&quot;, locals()) ? mu : &quot;&quot;));&amp;#10;psychoJS.experiment.addData(&quot;rt_sigma&quot;, (_pj.in_es6(&quot;sigma&quot;, locals()) ? sigma : &quot;&quot;));&amp;#10;psychoJS.experiment.addData(&quot;rt_recent&quot;, (_pj.in_es6(&quot;recent_rt&quot;, locals()) ? recent_rt : &quot;&quot;));&amp;#10;instruction_text.setAutoDraw(false);&amp;#10;if ((rt !== null)) {&amp;#10;    rt_list.push(rt);&amp;#10;}&amp;#10;if (next_is_probe) {&amp;#10;    trials_since_last_probe = 0;&amp;#10;} else {&amp;#10;    trials_since_last_probe += 1;&amp;#10;}&amp;#10;next_is_probe = false;&amp;#10;next_probe_type = null;&amp;#10;if ((rt_list.length &gt;= 60)) {&amp;#10;    mu = np.mean(rt_list);&amp;#10;    sigma = np.std(rt_list);&amp;#10;    recent_rts = rt_list.slice((- 3));&amp;#10;    if ((recent_rts.length === 3)) {&amp;#10;        recent_rt = np.mean(recent_rts);&amp;#10;        if ((((trials_since_last_probe &gt; 3) &amp;&amp; (Math.random.random() &lt; 0.4)) &amp;&amp; (util.sum(probe_counts.values()) &lt; total_probe_limit))) {&amp;#10;            if (((recent_rt &lt; (mu - sigma)) &amp;&amp; (probe_counts[&quot;fast&quot;] &lt; max_probes))) {&amp;#10;                next_is_probe = true;&amp;#10;                next_probe_type = &quot;fast&quot;;&amp;#10;                probe_counts[&quot;fast&quot;] += 1;&amp;#10;            } else {&amp;#10;                if (((recent_rt &gt; (mu + sigma)) &amp;&amp; (probe_counts[&quot;slow&quot;] &lt; max_probes))) {&amp;#10;                    next_is_probe = true;&amp;#10;                    next_probe_type = &quot;slow&quot;;&amp;#10;                    probe_counts[&quot;slow&quot;] += 1;&amp;#10;                } else {&amp;#10;                    if ((((trials_since_last_probe &gt; 50) &amp;&amp; (((mu - sigma) &lt;= recent_rt) &amp;&amp; (recent_rt &lt;= (mu + sigma)))) &amp;&amp; (probe_counts[&quot;avg&quot;] &lt; max_probes))) {&amp;#10;                        next_is_probe = true;&amp;#10;                        next_probe_type = &quot;avg&quot;;&amp;#10;                        probe_counts[&quot;avg&quot;] += 1;&amp;#10;                    }&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((rt_list.length &lt; 60)) {&amp;#10;        if ((((trials_since_last_probe &gt; 10) &amp;&amp; (Math.random.random() &lt; 0.4)) &amp;&amp; (probe_counts[&quot;ran&quot;] &lt; 4))) {&amp;#10;            next_is_probe = true;&amp;#10;            next_probe_type = &quot;ran&quot;;&amp;#10;            probe_counts[&quot;ran&quot;] += 1;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="response = key_resp.keys if key_resp.keys else None&amp;#10;rt = key_resp.rt if key_resp.keys else None&amp;#10;correct = 0&amp;#10;response_error = False&amp;#10;feedback_reps = 0&amp;#10;no_response = False&amp;#10;response_error = False&amp;#10;correct = 0&amp;#10;&amp;#10;response = key_resp.keys if key_resp.keys else None&amp;#10;rt = key_resp.rt if key_resp.keys else None&amp;#10;&amp;#10;if response is None:&amp;#10;    no_response = True&amp;#10;    feedback_reps = 1          # show &quot;Too slow&quot; feedback&amp;#10;&amp;#10;elif response == correct_response:&amp;#10;    correct = 1                # correct; no feedback&amp;#10;&amp;#10;else:  # response != correct_response&amp;#10;    response_error = True&amp;#10;    if is_probe:               # only probes get error feedback&amp;#10;        feedback_reps = 1&amp;#10;&amp;#10;'''if response is not None:    &amp;#10;    print(&quot;correct response: &quot; + correct_response)&amp;#10;    print(&quot;response: &quot; + response)'''&amp;#10;    &amp;#10;correct_responses.append(correct)&amp;#10;# code from search_ex&amp;#10;for d in DiamondDist:&amp;#10;    d.setAutoDraw(False)&amp;#10;for d in CircleDist:&amp;#10;    d.setAutoDraw(False)&amp;#10;for i in range(8):&amp;#10;    DistLines[i].setAutoDraw(False)&amp;#10;# end code from search_ex&amp;#10;&amp;#10;# After trials&amp;#10;total_trials = len(correct_responses)&amp;#10;total_correct = sum(correct_responses)&amp;#10;accuracy = total_correct / total_trials if total_trials &gt; 0 else 0&amp;#10;accuracy_percent = round(accuracy * 100, 2)&amp;#10;&amp;#10;thisExp.addData('response', response)&amp;#10;thisExp.addData('rt', rt)&amp;#10;thisExp.addData('correct_response', correct_response)&amp;#10;thisExp.addData('correct', correct)&amp;#10;thisExp.addData('correct_sum', accuracy_percent)&amp;#10;thisExp.addData('is_probe', is_probe)&amp;#10;thisExp.addData('probe_type', probe_type)&amp;#10;thisExp.addData('rt_mu', mu if 'mu' in locals() else '')&amp;#10;thisExp.addData('rt_sigma', sigma if 'sigma' in locals() else '')&amp;#10;thisExp.addData('rt_recent', recent_rt if 'recent_rt' in locals() else '')&amp;#10;&amp;#10;&amp;#10;instruction_text.setAutoDraw(False)&amp;#10;&amp;#10;if rt is not None:&amp;#10;    rt_list.append(rt)&amp;#10;    &amp;#10;# Update trial gap counter&amp;#10;if next_is_probe:&amp;#10;    trials_since_last_probe = 0&amp;#10;else:&amp;#10;    trials_since_last_probe += 1&amp;#10;&amp;#10;# Compute μ and σ after 80 trials&amp;#10;next_is_probe = False  # default&amp;#10;next_probe_type = None&amp;#10;&amp;#10;if len(rt_list) &gt;= 60:&amp;#10;    mu = np.mean(rt_list)&amp;#10;    sigma = np.std(rt_list)&amp;#10;    recent_rts = rt_list[-3:]&amp;#10;    if len(recent_rts) == 3:&amp;#10;        recent_rt = np.mean(recent_rts)&amp;#10;&amp;#10;        if trials_since_last_probe &gt; 3 and random.random() &lt; 0.4 and sum(probe_counts.values()) &lt; total_probe_limit:&amp;#10;            if recent_rt &lt; (mu - sigma) and probe_counts['fast'] &lt; max_probes:&amp;#10;                next_is_probe = True&amp;#10;                next_probe_type = 'fast'&amp;#10;                probe_counts['fast'] += 1&amp;#10;            elif recent_rt &gt; (mu + sigma) and probe_counts['slow'] &lt; max_probes:&amp;#10;                next_is_probe = True&amp;#10;                next_probe_type = 'slow'&amp;#10;                probe_counts['slow'] += 1&amp;#10;            elif trials_since_last_probe &gt; 50 and (mu - sigma) &lt;= recent_rt &lt;= (mu + sigma) and probe_counts['avg'] &lt; max_probes:&amp;#10;                next_is_probe = True&amp;#10;                next_probe_type = 'avg'&amp;#10;                probe_counts['avg'] += 1&amp;#10;elif len(rt_list) &lt; 60:&amp;#10;    if trials_since_last_probe &gt; 10 and random.random() &lt; 0.4 and probe_counts['ran'] &lt; 4:&amp;#10;        next_is_probe = True&amp;#10;        next_probe_type = 'ran'&amp;#10;        probe_counts['ran'] += 1" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trial_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
