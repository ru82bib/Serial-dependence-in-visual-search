        <Param val="if (((Number.parseFloat(FD_middle) &gt; 45) &amp;&amp; (Number.parseFloat(FD_middle) &lt; 135))) {&amp;#10;    x_D_FD_1 = (0.2 * Math.cos(((120 * math.pi) / 180)));&amp;#10;    y_D_FD_1 = (0.2 * Math.sin(((120 * math.pi) / 180)));&amp;#10;    x_D_FD_2 = (0.2 * Math.cos(((105 * math.pi) / 180)));&amp;#10;    y_D_FD_2 = (0.2 * Math.sin(((105 * math.pi) / 180)));&amp;#10;    x_D_FD_3 = (0.2 * Math.cos(((90 * math.pi) / 180)));&amp;#10;    y_D_FD_3 = (0.2 * Math.sin(((90 * math.pi) / 180)));&amp;#10;    x_D_FD_4 = (0.2 * Math.cos(((75 * math.pi) / 180)));&amp;#10;    y_D_FD_4 = (0.2 * Math.sin(((75 * math.pi) / 180)));&amp;#10;    x_D_FD_5 = (0.2 * Math.cos(((60 * math.pi) / 180)));&amp;#10;    y_D_FD_5 = (0.2 * Math.sin(((60 * math.pi) / 180)));&amp;#10;} else {&amp;#10;    if (((Number.parseFloat(FD_middle) &gt; 135) &amp;&amp; (Number.parseFloat(FD_middle) &lt; 225))) {&amp;#10;        x_D_FD_1 = (0.2 * Math.cos(((150 * math.pi) / 180)));&amp;#10;        y_D_FD_1 = (0.2 * Math.sin(((150 * math.pi) / 180)));&amp;#10;        x_D_FD_2 = (0.2 * Math.cos(((165 * math.pi) / 180)));&amp;#10;        y_D_FD_2 = (0.2 * Math.sin(((165 * math.pi) / 180)));&amp;#10;        x_D_FD_3 = (0.2 * Math.cos(((180 * math.pi) / 180)));&amp;#10;        y_D_FD_3 = (0.2 * Math.sin(((180 * math.pi) / 180)));&amp;#10;        x_D_FD_4 = (0.2 * Math.cos(((195 * math.pi) / 180)));&amp;#10;        y_D_FD_4 = (0.2 * Math.sin(((195 * math.pi) / 180)));&amp;#10;        x_D_FD_5 = (0.2 * Math.cos(((210 * math.pi) / 180)));&amp;#10;        y_D_FD_5 = (0.2 * Math.sin(((210 * math.pi) / 180)));&amp;#10;    } else {&amp;#10;        if (((Number.parseFloat(FD_middle) &gt; 225) &amp;&amp; (Number.parseFloat(FD_middle) &lt; 315))) {&amp;#10;            x_D_FD_1 = (0.2 * Math.cos(((300 * math.pi) / 180)));&amp;#10;            y_D_FD_1 = (0.2 * Math.sin(((300 * math.pi) / 180)));&amp;#10;            x_D_FD_2 = (0.2 * Math.cos(((285 * math.pi) / 180)));&amp;#10;            y_D_FD_2 = (0.2 * Math.sin(((285 * math.pi) / 180)));&amp;#10;            x_D_FD_3 = (0.2 * Math.cos(((270 * math.pi) / 180)));&amp;#10;            y_D_FD_3 = (0.2 * Math.sin(((270 * math.pi) / 180)));&amp;#10;            x_D_FD_4 = (0.2 * Math.cos(((255 * math.pi) / 180)));&amp;#10;            y_D_FD_4 = (0.2 * Math.sin(((255 * math.pi) / 180)));&amp;#10;            x_D_FD_5 = (0.2 * Math.cos(((240 * math.pi) / 180)));&amp;#10;            y_D_FD_5 = (0.2 * Math.sin(((240 * math.pi) / 180)));&amp;#10;        } else {&amp;#10;            if ((((Number.parseFloat(FD_middle) &gt; 315) &amp;&amp; (Number.parseFloat(FD_middle) &lt; 360)) || ((Number.parseFloat(FD_Half) &gt; 0) &amp;&amp; (Number.parseFloat(FD_Half) &lt; 45)))) {&amp;#10;                x_D_FD_1 = (0.2 * Math.cos(((30 * math.pi) / 180)));&amp;#10;                y_D_FD_1 = (0.2 * Math.sin(((30 * math.pi) / 180)));&amp;#10;                x_D_FD_2 = (0.2 * Math.cos(((15 * math.pi) / 180)));&amp;#10;                y_D_FD_2 = (0.2 * Math.sin(((15 * math.pi) / 180)));&amp;#10;                x_D_FD_3 = (0.2 * Math.cos(((0 * math.pi) / 180)));&amp;#10;                y_D_FD_3 = (0.2 * Math.sin(((0 * math.pi) / 180)));&amp;#10;                x_D_FD_4 = (0.2 * Math.cos(((345 * math.pi) / 180)));&amp;#10;                y_D_FD_4 = (0.2 * Math.sin(((345 * math.pi) / 180)));&amp;#10;                x_D_FD_5 = (0.2 * Math.cos(((330 * math.pi) / 180)));&amp;#10;                y_D_FD_5 = (0.2 * Math.sin(((330 * math.pi) / 180)));&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if float(FD_middle) &gt; 45 and float(FD_middle) &lt; 135:&amp;#10;    x_D_FD_1 = 0.2 * cos(120*math.pi/180)&amp;#10;    y_D_FD_1 = 0.2 * sin(120*math.pi/180)&amp;#10;    x_D_FD_2 = 0.2 * cos(105*math.pi/180)&amp;#10;    y_D_FD_2 = 0.2 * sin(105*math.pi/180)&amp;#10;    x_D_FD_3 = 0.2 * cos(90*math.pi/180)&amp;#10;    y_D_FD_3 = 0.2 * sin(90*math.pi/180)&amp;#10;    x_D_FD_4 = 0.2 * cos(75*math.pi/180)&amp;#10;    y_D_FD_4 = 0.2 * sin(75*math.pi/180)&amp;#10;    x_D_FD_5 = 0.2 * cos(60*math.pi/180)&amp;#10;    y_D_FD_5 = 0.2 * sin(60*math.pi/180)&amp;#10;    &amp;#10;elif float(FD_middle) &gt; 135 and float(FD_middle) &lt; 225:&amp;#10;    x_D_FD_1 = 0.2 * cos(150*math.pi/180)&amp;#10;    y_D_FD_1 = 0.2 * sin(150*math.pi/180)&amp;#10;    x_D_FD_2 = 0.2 * cos(165*math.pi/180)&amp;#10;    y_D_FD_2 = 0.2 * sin(165*math.pi/180)&amp;#10;    x_D_FD_3 = 0.2 * cos(180*math.pi/180)&amp;#10;    y_D_FD_3 = 0.2 * sin(180*math.pi/180)&amp;#10;    x_D_FD_4 = 0.2 * cos(195*math.pi/180)&amp;#10;    y_D_FD_4 = 0.2 * sin(195*math.pi/180)&amp;#10;    x_D_FD_5 = 0.2 * cos(210*math.pi/180)&amp;#10;    y_D_FD_5 = 0.2 * sin(210*math.pi/180)&amp;#10;elif float(FD_middle) &gt; 225 and float(FD_middle) &lt; 315:&amp;#10;    x_D_FD_1 = 0.2 * cos(300*math.pi/180)&amp;#10;    y_D_FD_1 = 0.2 * sin(300*math.pi/180)&amp;#10;    x_D_FD_2 = 0.2 * cos(285*math.pi/180)&amp;#10;    y_D_FD_2 = 0.2 * sin(285*math.pi/180)&amp;#10;    x_D_FD_3 = 0.2 * cos(270*math.pi/180)&amp;#10;    y_D_FD_3 = 0.2 * sin(270*math.pi/180)&amp;#10;    x_D_FD_4 = 0.2 * cos(255*math.pi/180)&amp;#10;    y_D_FD_4 = 0.2 * sin(255*math.pi/180)&amp;#10;    x_D_FD_5 = 0.2 * cos(240*math.pi/180)&amp;#10;    y_D_FD_5 = 0.2 * sin(240*math.pi/180)&amp;#10;elif (float(FD_middle) &gt; 315 and float(FD_middle) &lt; 360) or (float(FD_Half) &gt; 0 and float(FD_Half) &lt; 45):&amp;#10;    x_D_FD_1 = 0.2 * cos(30*math.pi/180)&amp;#10;    y_D_FD_1 = 0.2 * sin(30*math.pi/180)&amp;#10;    x_D_FD_2 = 0.2 * cos(15*math.pi/180)&a