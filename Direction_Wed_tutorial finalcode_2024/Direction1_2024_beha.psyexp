        <Param val="Block_text=''&amp;#10;Block_id = 0&amp;#10;Block_num = 8&amp;#10;Block_trial = 68&amp;#10;Practice_num = 10 # start from 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="Block_text = &quot;&quot;;&amp;#10;Block_id = 0;&amp;#10;Block_num = 8;&amp;#10;Block_trial = 68;&amp;#10;Practice_num = 10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = false;&amp;#10;if ((trials.thisTrialN === 0)) {&amp;#10;    Block_text = (&quot;Practice will start. &quot; + &quot; Please press s key to continue.&quot;);&amp;#10;    psychoJS.experiment.addData(&quot;Block_exp&quot;, Block_id);&amp;#10;} else {&amp;#10;    if (((trials.thisTrialN !== Practice_num) &amp;&amp; (trials.thisTrialN !== ((Block_trial * Block_id) + Practice_num)))) {&amp;#10;        psychoJS.experiment.addData(&quot;Block_exp&quot;, Block_id);&amp;#10;        continueRoutine = false;&amp;#10;    } else {&amp;#10;        if ((Block_id === Block_num)) {&amp;#10;            psychoJS.experiment.addData(&quot;Block_exp&quot;, Block_id);&amp;#10;            continueRoutine = false;&amp;#10;        } else {&amp;#10;            psychoJS.experiment.addData(&quot;Block_exp&quot;, Block_id);&amp;#10;            Block_id = (Block_id + 1);&amp;#10;            Block_text = ((((((&quot;Block (&quot; + Block_id.toString()) + &quot; / &quot;) + Block_num.toString()) + &quot;) &quot;) + &quot; will start. &quot;) + &quot; Please press s key to continue.&quot;);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# practice start&amp;#10;win.mouseVisible = False&amp;#10;if trials.thisTrialN ==0:&amp;#10;    Block_text='Practice will start. '+' Please press s key to continue.'&amp;#10;    thisExp.addData('Block_exp', Block_id)&amp;#10;# not practice or block start, then don't show the info of block&amp;#10;elif trials.thisTrialN != Practice_num and trials.thisTrialN != Block_trial*Block_id+Practice_num:&amp;#10;    thisExp.addData('Block_exp', Block_id)&amp;#10;    continueRoutine = False&amp;#10;    &amp;#10;else:&amp;#10;    # all blocks finished.&amp;#10;    if Block_id == Block_num: &amp;#10;        thisExp.addData('Block_exp', Block_id)&amp;#10;        continueRoutine = False&amp;#10;    # each block start.&amp;#10;    else:&amp;#10;        thisExp.addData('Block_exp', Block_id)&amp;#10;        Block_id = Block_id+1&amp;#10;        Block_text='Block ('+ str(Block_id) +' / ' +str(Block_num) +  ') '+ ' will start. '+' Please press s key to continue.'&amp;#10;        " valType="extendedCode" updates="constant" name="Begin Routine"/>
