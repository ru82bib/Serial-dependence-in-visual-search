      <CodeComponent name="Feedback_code_3" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="PresentDur = 0.5&amp;#10;&amp;#10;&amp;#10;&amp;#10;color_1 = [1,1,1];&amp;#10;color_2 = [1,1,1];&amp;#10;color_3 = [1,1,1];&amp;#10;color_4 = [1,1,1];&amp;#10;color_5 = [1,1,1];&amp;#10;&amp;#10;x_D_FD_1 = 0.2 * cos(150*math.pi/180)&amp;#10;y_D_FD_1 = 0.2 * sin(150*math.pi/180)&amp;#10;x_D_FD_2 = 0.2 * cos(120*math.pi/180)&amp;#10;y_D_FD_2 = 0.2 * sin(120*math.pi/180)&amp;#10;x_D_FD_3 = 0.2 * cos(90*math.pi/180)&amp;#10;y_D_FD_3 = 0.2 * sin(90*math.pi/180)&amp;#10;x_D_FD_4 = 0.2 * cos(60*math.pi/180)&amp;#10;y_D_FD_4 = 0.2 * sin(60*math.pi/180)&amp;#10;x_D_FD_5 = 0.2 * cos(30*math.pi/180)&amp;#10;y_D_FD_5 = 0.2 * sin(30*math.pi/180)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="PresentDur = 0.5;&amp;#10;color_1 = [1, 1, 1];&amp;#10;color_2 = [1, 1, 1];&amp;#10;color_3 = [1, 1, 1];&amp;#10;color_4 = [1, 1, 1];&amp;#10;color_5 = [1, 1, 1];&amp;#10;x_D_FD_1 = (0.2 * Math.cos(((150 * math.pi) / 180)));&amp;#10;y_D_FD_1 = (0.2 * Math.sin(((150 * math.pi) / 180)));&amp;#10;x_D_FD_2 = (0.2 * Math.cos(((120 * math.pi) / 180)));&amp;#10;y_D_FD_2 = (0.2 * Math.sin(((120 * math.pi) / 180)));&amp;#10;x_D_FD_3 = (0.2 * Math.cos(((90 * math.pi) / 180)));&amp;#10;y_D_FD_3 = (0.2 * Math.sin(((90 * math.pi) / 180)));&amp;#10;x_D_FD_4 = (0.2 * Math.cos(((60 * math.pi) / 180)));&amp;#10;y_D_FD_4 = (0.2 * Math.sin(((60 * math.pi) / 180)));&amp;#10;x_D_FD_5 = (0.2 * Math.cos(((30 * math.pi) / 180)));&amp;#10;y_D_FD_5 = (0.2 * Math.sin(((30 * math.pi) / 180)));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="PresentDur = 0.5;&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;Middle_Pos = (Number.parseFloat(FD_middle) + Math.random.uniform((- 1), 1));&amp;#10;x_D_FD_1 = (0.2 * Math.cos((((Middle_Pos + 40) * math.pi) / 180)));&amp;#10;y_D_FD_1 = (0.2 * Math.sin((((Middle_Pos + 40) * math.pi) / 180)));&amp;#10;x_D_FD_2 = (0.2 * Math.cos((((Middle_Pos + 20) * math.pi) / 180)));&amp;#10;y_D_FD_2 = (0.2 * Math.sin((((Middle_Pos + 20) * math.pi) / 180)));&amp;#10;x_D_FD_3 = (0.2 * Math.cos(((Middle_Pos * math.pi) / 180)));&amp;#10;y_D_FD_3 = (0.2 * Math.sin(((Middle_Pos * math.pi) / 180)));&amp;#10;x_D_FD_4 = (0.2 * Math.cos((((Middle_Pos - 20) * math.pi) / 180)));&amp;#10;y_D_FD_4 = (0.2 * Math.sin((((Middle_Pos - 20) * math.pi) / 180)));&amp;#10;x_D_FD_5 = (0.2 * Math.cos((((Middle_Pos - 40) * math.pi) / 180)));&amp;#10;y_D_FD_5 = (0.2 * Math.sin((((Middle_Pos - 40) * math.pi) / 180)));&amp;#10;if ((TrialType === &quot;Direction&quot;)) {&amp;#10;    if ((Key_release_D === 1)) {&amp;#10;        if ((Math.abs((Number.parseFloat(Final_angle) - Number.parseFloat(DirectionAngle))) &lt;= 3)) {&amp;#10;            color_3 = [0, 0.9, 0.3];&amp;#10;            psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 3);&amp;#10;        } else {&amp;#10;            if (((Number.parseFloat(Final_angle) - Number.parseFloat(DirectionAngle)) &gt; 10)) {&amp;#10;                color_1 = [1, 0, 0];&amp;#10;                psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 1);&amp;#10;            } else {&amp;#10;                if (((Number.parseFloat(DirectionAngle) - Number.parseFloat(Final_angle)) &gt; 10)) {&amp;#10;                    color_5 = [1, 0, 0];&amp;#10;                    psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 5);&amp;#10;                } else {&amp;#10;                    if ((((Number.parseFloat(DirectionAngle) - Number.parseFloat(Final_angle)) &gt; 3) &amp;&amp; ((Number.parseFloat(DirectionAngle) - Number.parseFloat(Final_angle)) &lt;= 10))) {&amp;#10;                        color_4 = [1, 0.3, 0.4];&amp;#10;                        psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 4);&amp;#10;                    } else {&amp;#10;                        if ((((Number.parseFloat(Final_angle) - Number.parseFloat(DirectionAngle)) &gt; 3) &amp;&amp; ((Number.parseFloat(Final_angle) - Number.parseFloat(DirectionAngle)) &lt;= 10))) {&amp;#10;                            color_2 = [1, 0.3, 0.4];&amp;#10;                            psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 2);&amp;#10;                        }&amp;#10;                    }&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    } else {&amp;#10;        psychoJS.experiment.addData(&quot;FeedbackID_D&quot;, 0);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="PresentDur = 0.5&amp;#10;&amp;#10;win.mouseVisible = False&amp;#10;&amp;#10;Middle_Pos = float(FD_middle)+random.uniform(-1, 1)&amp;#10;&amp;#10;&amp;#10;x_D_FD_1 = 0.2 * cos((Middle_Pos+40)*math.pi/180)&amp;#10;y_D_FD_1 = 0.2 * sin((Middle_Pos+40)*math.pi/180)&amp;#10;x_D_FD_2 = 0.2 * cos((Middle_Pos+20)*math.pi/180)&amp;#10;y_D_FD_2 = 0.2 * sin((Middle_Pos+20)*math.pi/180)&amp;#10;x_D_FD_3 = 0.2 * cos(Middle_Pos*math.pi/180)&amp;#10;y_D_FD_3 = 0.2 * sin(Middle_Pos*math.pi/180)&amp;#10;x_D_FD_4 = 0.2 * cos((Middle_Pos-20)*math.pi/180)&amp;#10;y_D_FD_4 = 0.2 * sin((Middle_Pos-20)*math.pi/180)&amp;#10;x_D_FD_5 = 0.2 * cos((Middle_Pos-40)*math.pi/180)&amp;#10;y_D_FD_5 = 0.2 * sin((Middle_Pos-40)*math.pi/180)&amp;#10;&amp;#10;# keep in mind the direction in Psychopy is counterclockwise&amp;#10;# and the 0 in psychopy is the 45.&amp;#10;if TrialType == 'Direction':&amp;#10;    if Key_release_D == 1:&amp;#10;        if abs(float(Final_angle) - float(DirectionAngle))&lt;= 3:&amp;#10;           color_3 = [0,0.9,0.3]; &amp;#10;           thisExp.addData('FeedbackID_D', 3)&amp;#10;           &amp;#10;        elif (float(Final_angle) - float(DirectionAngle))&gt;10:&amp;#10;            color_1 = [1,0,0];&amp;#10;            thisExp.addData('FeedbackID_D', 1)&amp;#10;&amp;#10;        elif (float(DirectionAngle)-float(Final_angle))&gt;10:&amp;#10;            color_5 = [1,0,0];&amp;#10;            thisExp.addData('FeedbackID_D', 5)&amp;#10;&amp;#10;        elif ((float(DirectionAngle)-float(Final_angle))&gt;3) and ((float(DirectionAngle)-float(Final_angle))&lt;=10) :&amp;#10;            color_4 = [1,0.3,0.4];&amp;#10;            thisExp.addData('FeedbackID_D', 4)&amp;#10;&amp;#10;        elif ((float(Final_angle)-float(DirectionAngle))&gt;3) and ((float(Final_angle)-float(DirectionAngle))&lt;=10) :&amp;#10;            color_2 = [1,0.3,0.4];&amp;#10;            thisExp.addData('FeedbackID_D', 2)&amp;#10;    else:&amp;#10;        thisExp.addData('FeedbackID_D', 0)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
