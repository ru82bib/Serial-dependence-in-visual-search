    <Routine name="Response_D_new">
      <RoutineSettingsComponent name="Response_D_new" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="Response_D_new" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="Resp_D_code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="from psychopy.hardware import keyboard&amp;#10;import math&amp;#10;&amp;#10;#if Sub_Order == '1':&amp;#10;#    PointerMove = - 0.5&amp;#10;    &amp;#10;#if Sub_Order == '2':&amp;#10;#    PointerMove = 0.5" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import {keyboard} from 'psychopy/hardware';&amp;#10;import * as math from 'math';&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = false;&amp;#10;Ini_angle = DirectionRes;&amp;#10;FD_middle = DirectionAngle;&amp;#10;Diff_A = Number.parseFloat((DirectionRes - DirectionAngle));&amp;#10;Pointer = 0.7;&amp;#10;x = (0.3 * Math.cos(((Ini_angle * math.pi) / 180)));&amp;#10;y = (0.3 * Math.sin(((Ini_angle * math.pi) / 180)));&amp;#10;angle_temp = 0;&amp;#10;kb = new keyboard.Keyboard();&amp;#10;kb.clock.reset();&amp;#10;time.reset();&amp;#10;RT_Direction = 9999;&amp;#10;keyDuration_D = 9999;&amp;#10;Key_pressed_D = false;&amp;#10;Key_release_D = 0;&amp;#10;kb.clearEvents({&quot;eventType&quot;: &quot;keyboard&quot;});&amp;#10;psychoJS.eventManager.clearEvents({&quot;eventType&quot;: &quot;keyboard&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="win.mouseVisible = False&amp;#10;Ini_angle = DirectionRes&amp;#10;FD_middle = DirectionAngle&amp;#10;&amp;#10;&amp;#10;Diff_A = float(DirectionRes - DirectionAngle)&amp;#10;&amp;#10;Pointer = 0.7 &amp;#10;&amp;#10;x = 0.3 * cos(Ini_angle * math.pi / 180)&amp;#10;y = 0.3 * sin(Ini_angle *math.pi /180)&amp;#10;&amp;#10;angle_temp = 0&amp;#10;&amp;#10;kb = keyboard.Keyboard()&amp;#10;kb.clock.reset()  # now t=0&amp;#10;time.reset()&amp;#10;&amp;#10;RT_Direction = 9999&amp;#10;keyDuration_D = 9999&amp;#10;Key_pressed_D = False # need an initial value&amp;#10;Key_release_D = 0&amp;#10;&amp;#10;kb.clearEvents(eventType='keyboard')&amp;#10;event.clearEvents(eventType='keyboard')&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="keys = kb.getKeys(keyList=['left', 'right'], waitRelease=False, clear=False)&amp;#10;&amp;#10;timeEnd = time.getTime()&amp;#10;&amp;#10;if (event.getKeys(keyList=['left', 'right'])):&amp;#10;    Key_pressed_D = True&amp;#10;    RT_Direction = time.getTime()&amp;#10;    &amp;#10;&amp;#10;# keep in mind the direction in Psychopy is counterclockwise&amp;#10;# and the 0 in psychopy is the 45.&amp;#10;for key in keys:&amp;#10;    if key.name == 'left': &amp;#10;          angle_temp = angle_temp + Pointer&amp;#10;    elif key.name == 'right':&amp;#10;          angle_temp = angle_temp - Pointer&amp;#10;        &amp;#10;    Ini_angle = DirectionRes + angle_temp&amp;#10;&amp;#10;    x = 0.3 * cos(Ini_angle *math.pi /180)&amp;#10;    y = 0.3 * sin(Ini_angle *math.pi /180)&amp;#10;        &amp;#10;    if key.duration != None:&amp;#10;        Key_pressed_D = False&amp;#10;        Key_release_D = 1&amp;#10;        &amp;#10;keyDuration_D = timeEnd - RT_Direction&amp;#10;textRT = round(keyDuration_D,2)&amp;#10;&amp;#10;Final_angle = Ini_angle%360&amp;#10;&amp;#10;#if Final_angle &gt; 180:&amp;#10;#     Final_angle = Final_angle - 180  # Reflect angle back to [0, 180]&amp;#10;&amp;#10;if Key_release_D == 1 or (timeEnd&gt;=6):&amp;#10;    continueRoutine = False&amp;#10;    &amp;#10;    &amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="keys = kb.getKeys({&quot;keyList&quot;: [&quot;left&quot;, &quot;right&quot;], &quot;waitRelease&quot;: false, &quot;clear&quot;: false});&amp;#10;timeEnd = time.getTime();&amp;#10;if (psychoJS.eventManager.getKeys({&quot;keyList&quot;: [&quot;left&quot;, &quot;right&quot;]})) {&amp;#10;    Key_pressed_D = true;&amp;#10;    RT_Direction = time.getTime();&amp;#10;}&amp;#10;for (var key, _pj_c = 0, _pj_a = keys, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    key = _pj_a[_pj_c];&amp;#10;    if ((key.name === &quot;left&quot;)) {&amp;#10;        angle_temp = (angle_temp + Pointer);&amp;#10;    } else {&amp;#10;        if ((key.name === &quot;right&quot;)) {&amp;#10;            angle_temp = (angle_temp - Pointer);&amp;#10;        }&amp;#10;    }&amp;#10;    Ini_angle = (DirectionRes + angle_temp);&amp;#10;    x = (0.3 * Math.cos(((Ini_angle * math.pi) / 180)));&amp;#10;    y = (0.3 * Math.sin(((Ini_angle * math.pi) / 180)));&amp;#10;    if ((key.duration !== null)) {&amp;#10;        Key_pressed_D = false;&amp;#10;        Key_release_D = 1;&amp;#10;    }&amp;#10;}&amp;#10;keyDuration_D = (timeEnd - RT_Direction);&amp;#10;textRT = util.round(keyDuration_D, 2);&amp;#10;Final_angle = (Ini_angle % 360);&amp;#10;if (((Key_release_D === 1) || (timeEnd &gt;= 6))) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
